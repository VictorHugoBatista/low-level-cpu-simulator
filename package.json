{
  "name": "low-level-cpu-simulator",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Simulador didático de um computador von Neumann de 8 bits (AK-8)",
  "bin": {
    "lcs": "dist-cli/cli/lcs.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "start": "npm run build && node dist-cli/cli/lcs.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "solid-js": "^1.9.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^3.2.4"
  }
}
